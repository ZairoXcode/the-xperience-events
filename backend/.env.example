# --- Server -----------------------------------------------
PORT=5000
NODE_ENV=development

# --- MongoDB ----------------------------------------------
# Local development (default)
MONGODB_URI=mongodb://127.0.0.1:27017/xperience_events

# --- JWT Authentication ------------------------------------
# REQUIRED: Change this to a strong random secret in production
JWT_SECRET=replace_this_with_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# --- AI / LLM Provider ------------------------------------
# AI_API_KEY is optional. If omitted, the built-in deterministic
# fallback engine handles standard event operations.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Compatible with any OpenAI-compatible provider (Groq, Ollama, OpenRouter):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama3-8b-8192

# --- CORS -------------------------------------------------
FRONTEND_URL=http://localhost:3000
